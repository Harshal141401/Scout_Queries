<?xml version = '1.0' encoding = 'utf-8'?>
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.1" xmlns:xdm="http://xmlns.oracle.com/oxp/xmlp" xmlns:xsd="http://wwww.w3.org/2001/XMLSchema" defaultDataSourceRef="Oracle BI EE">
   <dataProperties>
      <property name="include_parameters" value="true"/>
      <property name="include_null_Element" value="false"/>
      <property name="include_rowsettag" value="false"/>
      <property name="exclude_tags_for_lob" value="false"/>
      <property name="EXCLUDE_LINE_FEED_AND_CARRIAGE_RETURN_FOR_LOB" value="false"/>
      <property name="enable_sqlid_logging" value="true"/>
      <property name="xml_tag_case" value="upper"/>
      <property name="enforce_validation_status" value="true"/>
      <property name="optimize_query_executions" value="false"/>
      <property name="enable_xml_chunks" value=""/>
      <property name="sql_monitor_report_generated" value="false"/>
   </dataProperties>
   <dataSets>
      <dataSet name="open_transactions" type="complex">
         <sql dataSourceRef="ApplicationDB_FSCM">
            <![CDATA[-- ============================================================================
--  F7.1  Section 7.1 Open transactions summary (10 open-item classes)
--  Version   : 1.3 (2026-10-05). Not yet run on a pod. Row 1 also treats a
--              requisition line placed on a TRANSFER ORDER as no longer open.
--              V7_1 (R026) showed 1,632 of the 1,641 lines v1.2 counted belong
--              to internal transfer requisitions, which are filled by transfer
--              orders (TO_HEADER_ID) and never get a PO; Oracle indexes the pair
--              as NVL(TO_HEADER_ID, PO_HEADER_ID) (doc 25D). Rows 2-10 unchanged.
--              RUN V7_0 v1.3 (TO_HEADER_ID) AND V7_1 v1.3 FIRST.
--              v1.2 (2026-10-05). Adds row 9 (on-hand
--              inventory, item-org) and row 10 (open work orders), as the EBS v3
--              update did (EBS to Fusion/Phase2/sql/8.1_Open_Transactions_
--              Snapshot_v3.sql, 2026-10-01). Rows 1-8 are unchanged from v1.1.
--              (V7_0 / V7_1 v1.2 ran as R025 / R026.)
--              v1.1 (2026-10-05). V7_0 passed (R023).
--              V7_1 (R024) changed two rules, both in the shared open-item block:
--              row 1 now finds the PO link in PO_HEADER_ID and cancellation in
--              LINE_STATUS (LINE_LOCATION_ID was empty on all 7,525 live lines of
--              approved requisitions, 5,558 of them already on a PO; 322 lines
--              with LINE_STATUS CANCELED had no CANCEL_FLAG), and row 3 also
--              leaves out CANCELED schedules (CANCEL_FLAG is not set in Fusion).
--              Log every run in 06_Run_Results/RUN_LOG.md.
--  Source    : Oracle Fusion Cloud (BIP data model, data source ApplicationDB_FSCM)
--  Mirrors   : EBS agent ebs_discover_open_transactions / _open_txn_detail_sql
--              (PHASE2 v2 comment #21; report 30-Sep-2026, Vision: 178 | 304 |
--              347 | 3,399 $582.6 M | 1 | 115 | 977 $92.5 M | 1 $100 - EBS
--              numbers, not targets); rows 9-10 mirror EBS v3 classes 9-10
--              (Vision 1,509 item-org pairs / 59 open work orders, not targets)
--  Window    : NONE. A snapshot of what is open on the run day; the dates are
--              accepted and ignored. (EBS removed its window by measurement: it
--              discarded ~95% of the answer. An unpaid old invoice migrates like
--              any other.)
--  Scope     : the shared block's bu_scope. Blank ledger / BU = the whole pod.
--              Every document is given ONE business unit (column "BU" below),
--              so the by-BU workbook (F7.1_WB) sums exactly to these rows.
--              Rows 9-10 carry an inventory org, not a BU: each org takes its
--              business unit (INV_ORGANIZATION_DEFINITIONS_V.BUSINESS_UNIT_ID)
--              and counts only when that BU is in bu_scope, so a bound BU
--              limits them too (EBS v3 does the same through its OU).
--
--  OUTPUT  Open Item | Count | Value      (10 rows, EBS order)
--    Value only on rows 4, 7 and 8, in ENTERED currency as in EBS (amounts in
--    different currencies are added together - V7_1 block D / F shows the mix).
--    Value NULL = "-" in the report: a count-only row, never a zero.
--    Never total the Count column: the 10 rows count 10 different things.
--
--  THE 10 CLASSES (EBS rule -> Fusion; BU)
--    1 Open requisitions   POR_REQUISITION_HEADERS_ALL with DOCUMENT_STATUS
--                          'APPROVED' and at least one line that is approved
--                          (LINE_STATUS 'APPROVED': not cancelled, returned or
--                          rejected) and not yet on an order: no PO
--                          (PO_HEADER_ID) and, for an internal transfer
--                          requisition, no transfer order (TO_HEADER_ID).
--                          EBS reads AUTHORIZATION_STATUS, CANCEL_FLAG and
--                          LINE_LOCATION_ID; in Fusion the header has
--                          DOCUMENT_STATUS only (doc 25C) and, on this pod, lines
--                          carry the PO link in PO_HEADER_ID and cancellation in
--                          LINE_STATUS (R024). EBS's LINE_LOCATION_ID test never
--                          sees an internal requisition sourced from stock; in
--                          Fusion its counterpart is the transfer order (R026).
--                          BU = REQ_BU_ID (no ORG_ID in Fusion).
--    2 Open purchase orders  PO_HEADERS_ALL STANDARD, not cancelled, approved
--                          (APPROVED_FLAG 'Y'), DOCUMENT_STATUS not CLOSED /
--                          FINALLY CLOSED / CANCELED. The Fusion header has no
--                          CLOSED_CODE or AUTHORIZATION_STATUS (R020 column list).
--                          EBS also adds open blanket RELEASES: Fusion has no
--                          releases - an agreement raises standard POs, which are
--                          counted here. Agreements themselves are not open POs.
--                          BU = the procurement BU, else the requisitioning BU,
--                          else the bill-to BU: the first one in scope (the F4.1
--                          population: a PO is in scope when any of the three is).
--    3 Open PO receipts    PO_LINE_LOCATIONS_ALL schedules with QUANTITY_RECEIVED >
--                          QUANTITY_BILLED (received, not yet invoiced), not
--                          cancelled, SCHEDULE_STATUS not CLOSED / FINALLY CLOSED /
--                          CANCELED.
--                          Fusion schedules have SCHEDULE_STATUS, not CLOSED_CODE
--                          (doc 25C). Counted per schedule, as in EBS. A quantity
--                          test cannot see amount-based (services) schedules - as
--                          in EBS; V7_1 C9 counts what that leaves out.
--                          BU = the PO header's BU (class 2 rule).
--    4 Open Payables invoices  AP_INVOICES_ALL not cancelled, PAYMENT_STATUS_FLAG
--                          'N' or 'P' (unpaid / partly paid), every invoice type.
--                          Value = INVOICE_AMOUNT - AMOUNT_PAID. BU = ORG_ID.
--    5 Open prepayments    AP_INVOICES_ALL type PREPAYMENT, not cancelled, never
--                          applied: no AP_INVOICE_DISTRIBUTIONS_ALL row points back
--                          to one of its distributions through
--                          PREPAY_DISTRIBUTION_ID (doc 25D). BU = ORG_ID.
--    6 Open sales orders   DOO_HEADERS_ALL, ONE PER ORDER: revisions collapsed to
--                          the submitted version (the F4.2 rule; 11,703 header
--                          rows = 6,988 orders on this pod, R021). Open = OPEN_FLAG
--                          'Y' and CANCELED_FLAG not 'Y' on that version.
--                          BU = its ORG_ID.
--    7 Open Receivables invoices  AR_PAYMENT_SCHEDULES_ALL STATUS 'OP', CLASS
--                          'INV', collapsed to one row per transaction (schedules
--                          are per installment). Value = AMOUNT_DUE_REMAINING
--                          summed. BU = RA_CUSTOMER_TRX_ALL.ORG_ID.
--    8 Open or unapplied receipts  AR_PAYMENT_SCHEDULES_ALL STATUS 'OP', CLASS 'PMT',
--                          receipt not reversed (REVERSAL_DATE empty, STATUS not
--                          'REV'), one row per receipt. Value = the size of each
--                          receipt's open amount (ABS per receipt, then added; a
--                          receipt's open amount is stored as a negative).
--                          BU = AR_CASH_RECEIPTS_ALL.ORG_ID.
--    9 On-hand inventory (item-org)  INV_ONHAND_QUANTITIES_DETAIL (EBS
--                          MTL_ONHAND_QUANTITIES_DETAIL, doc 25C): one row per
--                          (inventory org, item) whose stock layers net to more
--                          than zero in the primary unit (PRIMARY_TRANSACTION_
--                          QUANTITY). A pair netting to zero or below holds no
--                          stock to load (V7_1 I1 counts the negative ones: a
--                          cutover clean-up item). Consigned stock (OWNING_TYPE
--                          set) is physically on hand and counted, as in EBS.
--                          Item x org is the EBS grain: it adds up across BUs;
--                          distinct items would not. BU = the org's BU.
--    10 Open work orders   WIE_WORK_ORDERS_B (EBS WIP_DISCRETE_JOBS) whose status
--                          rolls up to system status Released or On Hold
--                          (WIE_WO_STATUSES_B.WO_SYSTEM_STATUS_CODE, lookup
--                          ORA_WIE_WO_SYSTEM_STATUS, doc 25D). EBS open = Released,
--                          On Hold, Pending Close, Failed Close, Pending
--                          Scheduling; the last three are EBS close and
--                          scheduling states with no Fusion system status.
--                          Unreleased and Completed are not counted, as in EBS
--                          (Unreleased is EBS's open decision: V7_1 J0 prints the
--                          count). Every work order type is counted - EBS counts
--                          maintenance jobs too; V7_1 J splits them by type.
--                          BU = the org's BU.
--
--  DIFFERENCES FROM THE EBS AGENT (same metric, Fusion terms)
--    * rows 1-3: Fusion status columns as above (DOCUMENT_STATUS, LINE_STATUS,
--      SCHEDULE_STATUS); a code stored with '_' instead of ' ' is treated the
--      same. Fusion records cancellation in these status columns: CANCEL_FLAG
--      was empty on every PO header (260 CANCELED) and on cancelled requisition
--      lines (R024). V7_1 blocks A-C list every stored value and whether it is
--      counted.
--    * row 2: no releases (none in Fusion).
--    * row 6: one row per order, not per header row (Fusion keeps revisions).
--    * row 8: ABS per receipt (the agent takes ABS of each BU's total). Same
--      answer when every receipt has the same sign; never too low when not.
--    * row 10: Fusion statuses are user-defined and roll up to a system status;
--      the system status is tested, never a status name (names are setup- and
--      language-dependent).
--
--  CHANGES AGAINST THE JUNE DRAFT (02_SQL_Existing 16_S7.1)
--    * rows: 16 -> the 10 EBS classes. Dropped (not in the EBS report): invoices
--      on hold, open credit memos, blanket releases, backorders, pending
--      material transactions, FA mass additions, unposted journals. Added: open
--      PO receipts. On-hand and work orders are kept as EBS v3 defines them:
--      the draft counted distinct items (not additive by BU) and filtered work
--      orders on status NAMES ('Completed', 'Closed', ...); now item x org
--      pairs and the system status code.
--    * the fixed as-of date (05-May-2026) is gone: a run-day snapshot.
--    * AP: was STANDARD / CREDIT / MIXED only; now every type (EBS rule).
--    * AR: the extra COMPLETE_FLAG / TRX_DATE filters are gone (EBS rule).
--    * receipts: was UNAPP application rows with DISPLAY = 'Y'; now the open
--      receipt payment schedules (also catches on-account / unidentified cash).
--    * requisitions: was PRC_BU_ID (on the requisition header that is the
--      emergency-PO BU, doc 25C) and in-process statuses; now REQ_BU_ID and
--      APPROVED only. POs: approval is now tested; value removed (count only).
--    * sales orders: was every header row incl. revisions, valued at summed unit
--      prices; now one per order, count only.
--    * scope: was a mandatory single :p_ledger_id; now the shared block.
--    * output: was a formatted text value with a non-ASCII dash; now numeric.
-- ============================================================================
WITH
-- ---- PARAMS / WINDOW / SCOPE: copied unchanged from F1 (shared block v3.1).
params AS (
    SELECT :p_ledger_id     AS p_ledger_id,
           :p_bu_id         AS p_bu_id,
           :p_custom_prefix AS p_custom_prefix,
           :p_from_date     AS p_from_date,
           :p_to_date       AS p_to_date
    FROM   dual
),
-- ---- WINDOW: identical in F0 and F1 -------------------------------------
win AS (
    SELECT NVL(TO_DATE(p.p_from_date, 'YYYY-MM-DD'), TRUNC(SYSDATE) - 90) AS start_date,
           NVL(TO_DATE(p.p_to_date,   'YYYY-MM-DD'), TRUNC(SYSDATE)) + 1  AS end_date_excl
    FROM   params p
),
-- ---- SCOPE BLOCK: identical in F0 and F1 --------------------------------
led_scope AS (
    SELECT gl.ledger_id
    FROM   gl_ledgers gl
    CROSS  JOIN params p
    WHERE  gl.object_type_code = 'L'
    AND    NVL(gl.complete_flag, 'Y') = 'Y'
    AND    (p.p_ledger_id IS NULL OR gl.ledger_id = TO_NUMBER(p.p_ledger_id))
),
-- FUN_ALL_BUSINESS_UNITS_V.PRIMARY_LEDGER_ID is ORG_INFORMATION3 (a string),
-- so it is compared as a string. A BU whose classification STATUS is
-- inactive ('I' / 'INACTIVE') is excluded - the Fusion counterpart of the EBS
-- W3-Houston "disabled OU" rule. The view itself already drops BUs whose
-- effective dates have ended. V0_2 block A prints the STATUS values present.
bu_scope AS (
    SELECT bu.bu_id
    FROM   fun_all_business_units_v bu
    CROSS  JOIN params p
    WHERE  bu.primary_ledger_id IS NOT NULL
    AND    NVL(UPPER(bu.status), 'A') NOT IN ('I', 'INACTIVE')
    AND    (p.p_ledger_id IS NULL OR bu.primary_ledger_id = TRIM(p.p_ledger_id))
    AND    (p.p_bu_id     IS NULL OR bu.bu_id = TO_NUMBER(p.p_bu_id))
    GROUP  BY bu.bu_id
),
inv_org_scope AS (
    SELECT iod.organization_id
    FROM   inv_organization_definitions_v iod
    CROSS  JOIN params p
    WHERE  (p.p_ledger_id IS NULL OR iod.set_of_books_id = TO_NUMBER(p.p_ledger_id))
    GROUP  BY iod.organization_id
),
fa_book_scope AS (
    SELECT fbc.book_type_code
    FROM   fa_book_controls fbc
    CROSS  JOIN params p
    WHERE  (p.p_ledger_id IS NULL OR fbc.set_of_books_id = TO_NUMBER(p.p_ledger_id))
    GROUP  BY fbc.book_type_code
),
-- ==== OPEN-ITEM BLOCK v1.3: byte-identical in F7.1 and F7.1_WB ============
-- One row per (in-scope BU, class). Scope is applied INSIDE each class, by the
-- document's own BU column, so nothing outside scope can reach a total. If a
-- class rule changes, change BOTH files. Check: each F7.1 Count = that class
-- summed down the F7.1_WB rows (all 8 must tie).
--
-- PO header -> ONE in-scope BU: procurement, else requisitioning, else bill-to.
po_bu AS (
    SELECT ph.po_header_id,
           COALESCE(b1.bu_id, b2.bu_id, b3.bu_id) AS bu_id
    FROM        po_headers_all ph
    LEFT JOIN   bu_scope       b1 ON b1.bu_id = ph.prc_bu_id
    LEFT JOIN   bu_scope       b2 ON b2.bu_id = ph.req_bu_id
    LEFT JOIN   bu_scope       b3 ON b3.bu_id = ph.billto_bu_id
    WHERE       COALESCE(b1.bu_id, b2.bu_id, b3.bu_id) IS NOT NULL
),
-- Sales orders: one row per order, revisions collapsed (the F4.2 rule).
so_hdr AS (
    SELECT dh.order_number,
           dh.source_order_system,
           MAX(dh.org_id) KEEP (DENSE_RANK FIRST ORDER BY
               CASE WHEN dh.submitted_flag = 'Y' THEN 0 ELSE 1 END, dh.header_id DESC)
                                                                    AS org_id,
           MAX(dh.open_flag) KEEP (DENSE_RANK FIRST ORDER BY
               CASE WHEN dh.submitted_flag = 'Y' THEN 0 ELSE 1 END, dh.header_id DESC)
                                                                    AS open_flag,
           MAX(dh.canceled_flag) KEEP (DENSE_RANK FIRST ORDER BY
               CASE WHEN dh.submitted_flag = 'Y' THEN 0 ELSE 1 END, dh.header_id DESC)
                                                                    AS canceled_flag
    FROM   doo_headers_all dh
    GROUP  BY dh.order_number, dh.source_order_system
),
-- Receivables invoices: schedules are per installment -> one row per transaction.
ar_open_trx AS (
    SELECT ct.org_id                            AS bu_id,
           ps.customer_trx_id,
           SUM(NVL(ps.amount_due_remaining, 0)) AS amt_remaining
    FROM   ar_payment_schedules_all ps
    JOIN   ra_customer_trx_all      ct ON ct.customer_trx_id = ps.customer_trx_id
    JOIN   bu_scope                 b  ON b.bu_id = ct.org_id
    WHERE  ps.status = 'OP'
    AND    ps.class  = 'INV'
    GROUP  BY ct.org_id, ps.customer_trx_id
),
-- Receipts: one row per receipt; the size of its open amount (ABS per receipt).
rcpt_open AS (
    SELECT cr.org_id                                 AS bu_id,
           ps.cash_receipt_id,
           ABS(SUM(NVL(ps.amount_due_remaining, 0))) AS open_amt
    FROM   ar_payment_schedules_all ps
    JOIN   ar_cash_receipts_all     cr ON cr.cash_receipt_id = ps.cash_receipt_id
    JOIN   bu_scope                 b  ON b.bu_id = cr.org_id
    WHERE  ps.class  = 'PMT'
    AND    ps.status = 'OP'
    AND    cr.reversal_date IS NULL
    AND    NVL(cr.status, 'X') <> 'REV'
    GROUP  BY cr.org_id, ps.cash_receipt_id
),
-- Inventory org -> ONE in-scope BU, its business unit. Rows 9 and 10 only:
-- on-hand and work-order rows carry an inventory org, never a BU. Built on
-- bu_scope (as EBS v3 builds inv_org_ou on ou), so a bound ledger or BU
-- limits the orgs as well. V7_1 K checks that no org maps to two BUs.
inv_org_bu AS (
    SELECT iod.organization_id       AS inv_org_id,
           MAX(iod.business_unit_id) AS bu_id
    FROM   inv_organization_definitions_v iod
    JOIN   bu_scope                       b ON b.bu_id = iod.business_unit_id
    GROUP  BY iod.organization_id
),
-- On-hand: one row per (inventory org, item) that holds stock. Rows of the
-- on-hand table are stock LAYERS (subinventory, locator, lot, receipt), so
-- they are summed first, in the primary unit, and kept when the net is > 0.
onhand_pairs AS (
    SELECT io.bu_id,
           oh.organization_id,
           oh.inventory_item_id
    FROM   inv_onhand_quantities_detail oh
    JOIN   inv_org_bu                   io ON io.inv_org_id = oh.organization_id
    GROUP  BY io.bu_id, oh.organization_id, oh.inventory_item_id
    HAVING SUM(NVL(oh.primary_transaction_quantity, 0)) > 0
),
-- Work order statuses, one row per status id (the table carries seed-set
-- keys, so it is grouped before the join to keep work orders 1:1).
wo_status AS (
    SELECT st.wo_status_id,
           MAX(st.wo_system_status_code) AS system_status
    FROM   wie_wo_statuses_b st
    GROUP  BY st.wo_status_id
),
open_items AS (
    -- 1 open requisitions: approved, >= 1 approved line not yet on an order.
    --   A line is placed on a PO (PO_HEADER_ID) or - internal transfer
    --   requisitions - on a transfer order (TO_HEADER_ID); Oracle indexes the
    --   pair as NVL(TO_HEADER_ID, PO_HEADER_ID) (POR_REQUISITION_LINES_N33,
    --   doc 25D). LINE_LOCATION_ID is never filled here and cancellation is
    --   LINE_STATUS (CANCEL_FLAG stays empty) - measured in R024 / R026.
    SELECT rh.req_bu_id AS bu_id, 1 AS seq, COUNT(*) AS cnt, CAST(NULL AS NUMBER) AS amt
    FROM   por_requisition_headers_all rh
    JOIN   bu_scope                    b ON b.bu_id = rh.req_bu_id
    WHERE  rh.document_status = 'APPROVED'
    AND    EXISTS ( SELECT 1
                    FROM   por_requisition_lines_all rl
                    WHERE  rl.requisition_header_id = rh.requisition_header_id
                    AND    NVL(rl.cancel_flag, 'N') = 'N'
                    AND    rl.line_status = 'APPROVED'
                    AND    NVL(rl.to_header_id, rl.po_header_id) IS NULL )
    GROUP  BY rh.req_bu_id
    UNION ALL
    -- 2 open purchase orders: STANDARD, approved, not closed or cancelled
    SELECT pb.bu_id, 2, COUNT(*), CAST(NULL AS NUMBER)
    FROM   po_headers_all ph
    JOIN   po_bu          pb ON pb.po_header_id = ph.po_header_id
    WHERE  ph.type_lookup_code = 'STANDARD'
    AND    NVL(ph.cancel_flag, 'N') = 'N'
    AND    ph.approved_flag = 'Y'
    AND    REPLACE(UPPER(NVL(ph.document_status, 'OPEN')), '_', ' ')
               NOT IN ('CLOSED', 'FINALLY CLOSED', 'CANCELED', 'CANCELLED')
    GROUP  BY pb.bu_id
    UNION ALL
    -- 3 open PO receipts: schedules received but not yet invoiced
    SELECT pb.bu_id, 3, COUNT(*), CAST(NULL AS NUMBER)
    FROM   po_line_locations_all pll
    JOIN   po_bu                 pb ON pb.po_header_id = pll.po_header_id
    WHERE  NVL(pll.quantity_received, 0) > NVL(pll.quantity_billed, 0)
    AND    NVL(pll.cancel_flag, 'N') = 'N'
    AND    REPLACE(UPPER(NVL(pll.schedule_status, 'OPEN')), '_', ' ')
               NOT IN ('CLOSED', 'FINALLY CLOSED', 'CANCELED', 'CANCELLED')
    GROUP  BY pb.bu_id
    UNION ALL
    -- 4 open Payables invoices (value)
    SELECT ai.org_id, 4, COUNT(*),
           NVL(SUM(ai.invoice_amount - NVL(ai.amount_paid, 0)), 0)
    FROM   ap_invoices_all ai
    JOIN   bu_scope        b ON b.bu_id = ai.org_id
    WHERE  ai.cancelled_date IS NULL
    AND    NVL(ai.payment_status_flag, 'N') IN ('N', 'P')
    GROUP  BY ai.org_id
    UNION ALL
    -- 5 open prepayments: never applied to an invoice
    SELECT ai.org_id, 5, COUNT(*), CAST(NULL AS NUMBER)
    FROM   ap_invoices_all ai
    JOIN   bu_scope        b ON b.bu_id = ai.org_id
    WHERE  ai.cancelled_date IS NULL
    AND    ai.invoice_type_lookup_code = 'PREPAYMENT'
    AND    NOT EXISTS ( SELECT 1
                        FROM   ap_invoice_distributions_all pd
                        JOIN   ap_invoice_distributions_all cd
                               ON cd.prepay_distribution_id = pd.invoice_distribution_id
                        WHERE  pd.invoice_id = ai.invoice_id )
    GROUP  BY ai.org_id
    UNION ALL
    -- 6 open sales orders: one per order
    SELECT so.org_id, 6, COUNT(*), CAST(NULL AS NUMBER)
    FROM   so_hdr   so
    JOIN   bu_scope b ON b.bu_id = so.org_id
    WHERE  NVL(so.open_flag, 'N') = 'Y'
    AND    NVL(so.canceled_flag, 'N') = 'N'
    GROUP  BY so.org_id
    UNION ALL
    -- 7 open Receivables invoices (value)
    SELECT t.bu_id, 7, COUNT(*), NVL(SUM(t.amt_remaining), 0)
    FROM   ar_open_trx t
    GROUP  BY t.bu_id
    UNION ALL
    -- 8 open or unapplied receipts (value)
    SELECT r.bu_id, 8, COUNT(*), NVL(SUM(r.open_amt), 0)
    FROM   rcpt_open r
    GROUP  BY r.bu_id
    UNION ALL
    -- 9 on-hand inventory: (inventory org, item) pairs holding stock
    SELECT p.bu_id, 9, COUNT(*), CAST(NULL AS NUMBER)
    FROM   onhand_pairs p
    GROUP  BY p.bu_id
    UNION ALL
    -- 10 open work orders: system status Released or On Hold. A code stored
    --    with the ORA_ prefix or '_' for ' ' is treated the same.
    SELECT io.bu_id, 10, COUNT(*), CAST(NULL AS NUMBER)
    FROM   wie_work_orders_b wo
    JOIN   inv_org_bu        io ON io.inv_org_id   = wo.organization_id
    JOIN   wo_status         ws ON ws.wo_status_id = wo.work_order_status_id
    WHERE  REPLACE(REPLACE(UPPER(NVL(ws.system_status, 'X')), 'ORA_', ''), '_', ' ')
               IN ('RELEASED', 'ON HOLD')
    GROUP  BY io.bu_id
),
-- ==== END OF OPEN-ITEM BLOCK ===============================================
cls AS (
    SELECT 1 AS seq, 'Open requisitions' AS open_item, 'N' AS has_value FROM dual
    UNION ALL SELECT 2, 'Open purchase orders',       'N' FROM dual
    UNION ALL SELECT 3, 'Open PO receipts',           'N' FROM dual
    UNION ALL SELECT 4, 'Open Payables invoices',     'Y' FROM dual
    UNION ALL SELECT 5, 'Open prepayments',           'N' FROM dual
    UNION ALL SELECT 6, 'Open sales orders',          'N' FROM dual
    UNION ALL SELECT 7, 'Open Receivables invoices',  'Y' FROM dual
    UNION ALL SELECT 8, 'Open or unapplied receipts', 'Y' FROM dual
    UNION ALL SELECT 9, 'On-hand inventory (item-org)', 'N' FROM dual
    UNION ALL SELECT 10, 'Open work orders',          'N' FROM dual
),
class_tot AS (
    SELECT oi.seq, SUM(oi.cnt) AS cnt, SUM(oi.amt) AS amt
    FROM   open_items oi
    GROUP  BY oi.seq
)
-- LEFT JOIN: a class with nothing open still prints its row, as 0.
SELECT
    c.open_item                                               AS "Open Item",
    NVL(t.cnt, 0)                                             AS "Count",
    CASE WHEN c.has_value = 'Y' THEN NVL(t.amt, 0) END        AS "Value"
FROM        cls       c
LEFT JOIN   class_tot t ON t.seq = c.seq
ORDER BY    c.seq
]]>
         </sql>
      </dataSet>
   </dataSets>
   <output rootName="DATA_DS" uniqueRowName="false">
      <nodeList name="data-structure">
         <dataStructure tagName="DATA_DS">
            <group name="G_1" label="G_1" source="open_transactions">
               <element name="Open_Item" value="Open Item" label="Open_Item" dataType="xsd:string" breakOrder="" fieldOrder="1"/>
               <element name="Count" value="Count" label="Count" dataType="xsd:double" breakOrder="" fieldOrder="2"/>
               <element name="Value" value="Value" label="Value" dataType="xsd:double" breakOrder="" fieldOrder="3"/>
            </group>
         </dataStructure>
      </nodeList>
   </output>
